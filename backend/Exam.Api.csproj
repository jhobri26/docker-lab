<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Content/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content/*.md;Content/*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
